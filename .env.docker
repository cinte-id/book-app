# Development Environment - Docker Compose
# Copy this file to .env.docker for docker-compose development

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Database Configuration (SQLite for development)
DATABASE_URL=sqlite:///books.db

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,http://localhost:80,http://127.0.0.1:5173

# Security (Development - Change for production)
SECRET_KEY=dev-secret-key-change-in-production-123456789

# API Configuration
API_PREFIX=/api

# File Storage
DATA_FILE=books.json

# Frontend Configuration
VITE_API_URL=http://localhost:5001
VITE_API_BASE_URL=http://localhost:5001/api
VITE_NODE_ENV=development
