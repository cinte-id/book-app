    {
      "id": 5,
      "type": "timeseries",
      "title": "Response Time (probe duration)",
      "datasource": "Prometheus",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "probe_duration_seconds{app=\"frontend-react\"}",
          "refId": "A",
          "legendFormat": "Frontend"
        },
        {
          "expr": "probe_duration_seconds{app=\"backend-flask\"}",
          "refId": "B",
          "legendFormat": "Backend"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
