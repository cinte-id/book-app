FLASK_ENV=production
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Production: use persistent volume path
DATA_FILE=/data/books.json

# CORS: restrict to production domain only
CORS_ORIGINS=https://yourdomain.com

# SECRET_KEY must be injected via GitHub Secrets (never hardcoded)
# Set as GitHub Secret: PROD_SECRET_KEY
SECRET_KEY=INJECT_FROM_GITHUB_SECRETS
