FLASK_ENV=staging
FLASK_DEBUG=false
FLASK_HOST=0.0.0.0
FLASK_PORT=5001

# Staging uses same JSON-based storage as dev — not production DB
DATA_FILE=/data/books.json

# CORS: staging frontend domain
CORS_ORIGINS=http://staging.localhost,http://localhost

# SECRET_KEY must be injected via GitHub Secrets (never hardcoded)
# Set as GitHub Secret: STAGING_SECRET_KEY
SECRET_KEY=INJECT_FROM_GITHUB_SECRETS
