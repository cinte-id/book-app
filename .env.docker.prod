# Production Environment - Docker Compose
# Must be set before running: docker-compose -f docker-compose.prod.yml up

# Flask Configuration
FLASK_ENV=production
FLASK_DEBUG=False

# Database Configuration (PostgreSQL)
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_NAME=booktracker_prod
DATABASE_URL=postgresql://postgres:CHANGE_THIS_TO_STRONG_PASSWORD@postgres:5432/booktracker_prod

# CORS Configuration - Update with actual production domain
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Security - Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GENERATE_SECURE_KEY_WITH_PYTHON_SECRETS

# Frontend Configuration
VITE_API_URL=https://yourdomain.com
VITE_API_BASE_URL=https://yourdomain.com/api
VITE_NODE_ENV=production
